# Copy to .kamal/kit.local.env (git-ignored) on each machine that deploys.
# kit exports these, so Kamal's config (deploy/deploy.yml) reads them too.
# To run `kamal` itself: set -a; . .kamal/kit.local.env; set +a

# The VPS (FazouraParty's), its deploy user, and the directory holding .env there.
TRIVIA_RELAY_HOST=
TRIVIA_RELAY_SSH_USER=deploy
TRIVIA_RELAY_DEPLOY_DIR=/srv/trivia-relay

# The domain Caddy serves and kamal-proxy routes (PHX_HOST in the server's .env).
TRIVIA_RELAY_PUBLIC_HOST=

# A GitHub token with read:packages only (a classic token; the image lives on
# ghcr.io). Kamal logs the server in with it to pull; CI is what pushes.
TRIVIA_RELAY_REGISTRY_TOKEN=

# Checked from outside after each deploy, through Caddy and kamal-proxy as a phone
# reaches it; a failure rolls the deploy back.
KIT_SMOKE_URLS="https://<domain>/health|200|ok"

# Where the kit's notifications go, if anywhere. Telegram, a webhook (Slack,
# Discord), or ntfy.
# KIT_TELEGRAM_BOT_TOKEN=
# KIT_TELEGRAM_CHAT_ID=
