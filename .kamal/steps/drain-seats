#!/usr/bin/env bash
# pre-app-boot: tell the running relay to close its seats with `shutdown` before the new
# container starts (SIGUSR2, TriviaRelay.Seats.Drain). kamal-proxy cuts the old
# container's WebSockets the moment the new one is healthy, and Kamal only stops the
# old one after that, so the drain SIGTERM starts would reach nobody: phones would
# reconnect into `seat_not_found` instead of being told the relay restarted.
#
# Seats are in memory and end on a deploy either way; this is only about ending them
# out loud. The old container keeps serving everything else until the switch. An image
# from before the handler ignores the signal.
# shellcheck source=/dev/null
. "$KIT_HOME/steps/_preamble.sh"
# shellcheck source=/dev/null
. "$KIT_HOME/lib/kamal.sh"

kit_kamal server exec -H -q \
  "docker ps -q --filter label=service=${KAMAL_SERVICE:-trivia-relay} --filter label=role=web --filter label=destination=${KAMAL_DESTINATION:-} --filter status=running | xargs -r docker kill --signal USR2"
kit_ok "asked the running relay to close its seats"
