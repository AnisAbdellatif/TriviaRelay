<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below, if a backup runs despite allowBackup="false": nothing is
     included. See the comment on <application> in AndroidManifest.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
