# The relay's secrets on the VPS: /srv/trivia-relay/.env, and nowhere else
# (deploy/README.md, "Secrets on the VPS"). The container reads it with --env-file,
# and Docker reads it literally: no quotes around values, no $VAR, no export.

# `mix phx.gen.secret` (in server/).
SECRET_KEY_BASE=

# The public domain: the same as TRIVIA_RELAY_PUBLIC_HOST and the one Caddy serves.
# Phoenix builds its URLs and checks WebSocket origins against it.
PHX_HOST=

# The Sporcle Party app's API key. server/.env.example says what it is and where it
# comes from.
SPORCLE_API_KEY=

# How long a seat stays in its game with no phone attached, in seconds (default 300).
# SEAT_HOLD_SECONDS=300

# The SHA-256 fingerprint of the key the Android release is signed with, as
# `keytool -list -v` or `apksigner verify --print-certs` prints it (AB:CD:…, 32 bytes);
# several, comma-separated, while a key is being rotated. The relay serves it at
# /.well-known/assetlinks.json so the released app opens invite links
# (https://<PHX_HOST>/join/<code>) itself. Unset, that is a 404, and links open the web app.
# ANDROID_CERT_SHA256=
